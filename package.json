{
  "name": "@local/windows-laptop-inspector",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Inspect a Windows laptop's hardware, battery health, and overall condition, then export the report as JSON, HTML, or PDF.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "inspector.py",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
